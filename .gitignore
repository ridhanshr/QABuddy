# Dependency directories
node_modules/

# Build outputs
dist/
dist_nsis/
out/

# Rust build artifacts (can be 10-40 GB, always regenerated by cargo)
src-tauri/target/
src-tauri/target.nosync/

# Tauri bundle output
src-tauri/gen/

# Cargo local config (machine-specific linker settings)
src-tauri/.cargo/

# Temp files
electron.vite.config.*.mjs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS metadata
.DS_Store
Thumbs.db

# Backups
backup-*/

# Local configurations / secrets
qa-buddy-config.json
.env
.env.local
.env.*.local

# Agent/Tool Directories
.agent/
.agents/
.codex/
.omx/
.opencode/
.idea/
.vscode/

# Project specific resources and examples
design-system/
example-program/
requirement/

# Test output
test-results/

# Vite HMR timestamp cache (auto-generated, machine-specific)
vite.config.mts.timestamp-*

# RAG vector DB snapshots (machine-specific, regenerated on startup)
src-tauri/.qa-buddy-rag/snap.*
.gitignore
